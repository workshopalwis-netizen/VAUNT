<div class="cart-drawer" id="cartDrawer" role="dialog" aria-modal="true" aria-label="Shopping Cart">
  <div class="cart-backdrop"></div>
  <div class="cart-panel">
    
    <div class="cart-header">
      <h3 class="cart-title">YOUR CART</h3>
      <button type="button" class="cart-close-btn" aria-label="Close cart">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Free Shipping Progress -->
    <div class="shipping-progress-container">
      <div class="shipping-progress-text">
        <span>You are <strong>LKR 10,000</strong> away from <strong>FREE SHIPPING</strong></span>
      </div>
      <div class="shipping-progress-bar">
        <div class="shipping-progress-fill"></div>
      </div>
    </div>

    <!-- Cart Body -->
    <div class="cart-body">
      <div class="cart-empty">
        <svg class="cart-empty-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
        <h4 class="cart-empty-title">YOUR CART IS EMPTY</h4>
        <p class="cart-empty-desc">Discover our latest drop and elevate your everyday wardrobe.</p>
        <a href="/collections/all" class="btn btn-primary btn-sm" onclick="Vaunt.closeCartDrawer()">EXPLORE COLLECTION</a>
      </div>

      <div class="cart-items-list" style="display: none;"></div>
    </div>

    <!-- Footer -->
    <div class="cart-footer">
      <div class="cart-subtotal-row">
        <span>SUBTOTAL</span>
        <span class="cart-subtotal-amount">LKR 0</span>
      </div>
      <p class="cart-shipping-notice">Taxes and express shipping calculated at checkout.</p>
      <form action="{{ routes.cart_url }}" method="post" id="cart-drawer-form">
        <button type="submit" name="checkout" class="btn btn-primary btn-block cart-checkout-btn">
          CHECKOUT &bull; SECURE
        </button>
      </form>
      <a href="#" class="cart-continue-btn" onclick="Vaunt.closeCartDrawer(); return false;">CONTINUE SHOPPING</a>
    </div>

  </div>
</div>
