{%- comment -%}
  Parameters:
  - product: Product object
  - show_trending: Boolean
{%- endcomment -%}

<div class="product-card" data-product-id="{{ product.id }}">
  <div class="product-card-media">
    <a href="{{ product.url }}">
      <img src="{{ product.featured_image | image_url: width: 700 }}" alt="{{ product.title | escape }}" class="product-card-image primary" loading="lazy">
      {%- if product.images[1] != blank -%}
        <img src="{{ product.images[1] | image_url: width: 700 }}" alt="{{ product.title | escape }}" class="product-card-image secondary" loading="lazy">
      {%- endif -%}
    </a>

    <!-- Badges -->
    <div class="product-card-badges">
      {%- if show_trending -%}
        <span class="badge badge-trending">TRENDING</span>
      {%- endif -%}
      {%- if product.compare_at_price > product.price -%}
        <span class="badge badge-sale">SALE</span>
      {%- endif -%}
    </div>

    <!-- Wishlist Button -->
    <button type="button" class="product-card-wishlist" data-wishlist-id="{{ product.id }}" aria-label="Add to Wishlist">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
      </svg>
    </button>

    <!-- Card Action Overlay -->
    <div class="product-card-actions">
      <button type="button" class="btn-quickadd" data-product-id="{{ product.id }}">Quick Add</button>
      <button type="button" class="btn-quickview" data-quickview-id="{{ product.id }}">Quick View</button>
    </div>
  </div>

  <div class="product-card-content">
    <h3 class="product-card-title">
      <a href="{{ product.url }}">{{ product.title }}</a>
    </h3>
    <div class="product-card-pricing">
      <span class="product-price">{{ product.price | money }}</span>
      {%- if product.compare_at_price > product.price -%}
        <span class="product-price-compare">{{ product.compare_at_price | money }}</span>
      {%- endif -%}
    </div>
  </div>
</div>
