<section class="container section-spacing">
  
  <div class="collection-toolbar">
    <div class="toolbar-left">
      <span class="filter-count">{{ collection.products_count | default: 0 }} Products</span>
    </div>
    <div class="toolbar-right">
      <div class="sort-select-wrapper">
        <label for="ShopifySortSelect">SORT BY:</label>
        <select id="ShopifySortSelect" class="sort-select" onchange="location = this.value;">
          {%- for option in collection.sort_options -%}
            <option value="?sort_by={{ option.value }}" {% if option.value == collection.sort_by %}selected{% endif %}>
              {{ option.name }}
            </option>
          {%- endfor -%}
        </select>
      </div>
    </div>
  </div>

  <div class="product-grid cols-{{ section.settings.columns_desktop }}">
    {%- paginate collection.products by section.settings.products_per_page -%}
      {%- for product in collection.products -%}
        {% render 'product-card', product: product %}
      {%- else -%}
        <div style="grid-column: 1 / -1; text-align: center; padding: 60px 0;">
          <h3>No products found in this collection.</h3>
        </div>
      {%- endfor -%}
    {%- endpaginate -%}
  </div>

</section>

{% schema %}
{
  "name": "Main Collection",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 16
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on Desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    }
  ]
}
{% endschema %}
