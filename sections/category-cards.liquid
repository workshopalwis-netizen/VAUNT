<section class="section-spacing container" aria-label="Shop by Category">
  <div class="section-header">
    {%- if section.settings.eyebrow != blank -%}
      <span class="section-eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    <h2 class="section-title">{{ section.settings.heading }}</h2>
  </div>

  <div class="category-grid">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link }}" class="category-card" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <img src="{{ block.settings.image | image_url: width: 900 }}" alt="{{ block.settings.title | escape }}" loading="lazy">
        {%- else -%}
          <img src="https://images.unsplash.com/photo-1507679799987-c73779587ccf?auto=format&fit=crop&w=900&q=80" alt="{{ block.settings.title | escape }}" loading="lazy">
        {%- endif -%}
        <div class="category-card-overlay"></div>
        <div class="category-card-content">
          <h3 class="category-card-title">{{ block.settings.title }}</h3>
          <span class="category-card-btn">{{ block.settings.button_text }} &rarr;</span>
        </div>
      </a>
    {%- else -%}
      <!-- Default 4 Cards -->
      <a href="/collections/men" class="category-card">
        <img src="https://images.unsplash.com/photo-1507679799987-c73779587ccf?auto=format&fit=crop&w=900&q=80" alt="Men" loading="lazy">
        <div class="category-card-overlay"></div>
        <div class="category-card-content">
          <h3 class="category-card-title">MEN</h3>
          <span class="category-card-btn">SHOP MEN &rarr;</span>
        </div>
      </a>
      <a href="/collections/women" class="category-card">
        <img src="https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?auto=format&fit=crop&w=900&q=80" alt="Women" loading="lazy">
        <div class="category-card-overlay"></div>
        <div class="category-card-content">
          <h3 class="category-card-title">WOMEN</h3>
          <span class="category-card-btn">SHOP WOMEN &rarr;</span>
        </div>
      </a>
      <a href="/collections/all?filter=new" class="category-card">
        <img src="https://images.unsplash.com/photo-1539109136881-3be0616acf4b?auto=format&fit=crop&w=900&q=80" alt="New Arrivals" loading="lazy">
        <div class="category-card-overlay"></div>
        <div class="category-card-content">
          <h3 class="category-card-title">NEW ARRIVALS</h3>
          <span class="category-card-btn">SHOP NEW ARRIVALS &rarr;</span>
        </div>
      </a>
      <a href="/collections/accessories" class="category-card">
        <img src="https://images.unsplash.com/photo-1548036328-c9fa89d128fa?auto=format&fit=crop&w=900&q=80" alt="Accessories" loading="lazy">
        <div class="category-card-overlay"></div>
        <div class="category-card-content">
          <h3 class="category-card-title">ACCESSORIES</h3>
          <span class="category-card-btn">SHOP ACCESSORIES &rarr;</span>
        </div>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Category Cards",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "DISCOVER ARCHIVES"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SHOP BY CATEGORY"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "CATEGORY NAME"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Label",
          "default": "SHOP NOW"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Collection Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category Cards",
      "blocks": [
        { "type": "category", "settings": { "title": "MEN", "button_text": "SHOP MEN" } },
        { "type": "category", "settings": { "title": "WOMEN", "button_text": "SHOP WOMEN" } },
        { "type": "category", "settings": { "title": "NEW ARRIVALS", "button_text": "SHOP NEW ARRIVALS" } },
        { "type": "category", "settings": { "title": "ACCESSORIES", "button_text": "SHOP ACCESSORIES" } }
      ]
    }
  ]
}
{% endschema %}
