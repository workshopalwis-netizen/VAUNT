<footer class="site-footer">
  <div class="container">
    <div class="footer-main">
      
      <!-- Brand column -->
      <div class="footer-brand-col">
        <a href="{{ routes.root_url }}" class="site-logo" style="color: var(--color-white);">
          {{ shop.name | default: 'VAUNT' }}<span class="accent-dot"></span>
        </a>
        <p class="footer-tagline">{{ section.settings.tagline | default: 'Architectural silhouettes, heavyweight organic textiles, and refined contemporary luxury engineered for modern life.' }}</p>
        <div class="footer-social-links">
          {%- if settings.social_instagram_link != blank -%}
            <a href="{{ settings.social_instagram_link }}" class="footer-social-icon" aria-label="Instagram">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_facebook_link != blank -%}
            <a href="{{ settings.social_facebook_link }}" class="footer-social-icon" aria-label="Facebook">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_tiktok_link != blank -%}
            <a href="{{ settings.social_tiktok_link }}" class="footer-social-icon" aria-label="TikTok">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_youtube_link != blank -%}
            <a href="{{ settings.social_youtube_link }}" class="footer-social-icon" aria-label="YouTube">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon></svg>
            </a>
          {%- endif -%}
        </div>
      </div>

      <!-- Links Columns -->
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          <h4 class="footer-heading">{{ block.settings.heading }}</h4>
          <ul class="footer-links">
            {%- for link in linklists[block.settings.menu].links -%}
              <li><a href="{{ link.url }}" class="footer-link">{{ link.title }}</a></li>
            {%- else -%}
              <li><a href="#" class="footer-link">Link 1</a></li>
              <li><a href="#" class="footer-link">Link 2</a></li>
              <li><a href="#" class="footer-link">Link 3</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- else -%}
        <!-- Default columns -->
        <div>
          <h4 class="footer-heading">SHOP</h4>
          <ul class="footer-links">
            <li><a href="/collections/men" class="footer-link">Men</a></li>
            <li><a href="/collections/women" class="footer-link">Women</a></li>
            <li><a href="/collections/all?filter=new" class="footer-link">New Arrivals</a></li>
            <li><a href="/collections/all?filter=bestsellers" class="footer-link">Best Sellers</a></li>
            <li><a href="/collections/all?filter=sale" class="footer-link">Sale</a></li>
          </ul>
        </div>

        <div>
          <h4 class="footer-heading">HELP</h4>
          <ul class="footer-links">
            <li><a href="/pages/contact" class="footer-link">Contact Us</a></li>
            <li><a href="/pages/faq" class="footer-link">FAQ</a></li>
            <li><a href="/pages/shipping" class="footer-link">Shipping</a></li>
            <li><a href="/pages/returns" class="footer-link">Returns</a></li>
            <li><a href="/pages/size-guide" class="footer-link">Size Guide</a></li>
          </ul>
        </div>

        <div>
          <h4 class="footer-heading">ABOUT</h4>
          <ul class="footer-links">
            <li><a href="/pages/our-story" class="footer-link">Our Story</a></li>
            <li><a href="/pages/careers" class="footer-link">Careers</a></li>
            <li><a href="/pages/sustainability" class="footer-link">Sustainability</a></li>
          </ul>
        </div>

        <div>
          <h4 class="footer-heading">LEGAL</h4>
          <ul class="footer-links">
            <li><a href="/policies/privacy-policy" class="footer-link">Privacy Policy</a></li>
            <li><a href="/policies/terms-of-service" class="footer-link">Terms & Conditions</a></li>
            <li><a href="/policies/refund-policy" class="footer-link">Refund Policy</a></li>
          </ul>
        </div>
      {%- endfor -%}

    </div>

    <!-- Bottom -->
    <div class="footer-bottom">
      <div class="footer-bottom-inner">
        <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | default: 'VAUNT ATELIER' }}. ALL RIGHTS RESERVED.</p>
        <div class="payment-icons">
          {%- if section.settings.show_payment_icons -%}
            <span class="payment-badge">VISA</span>
            <span class="payment-badge">MASTERCARD</span>
            <span class="payment-badge">AMEX</span>
            <span class="payment-badge">APPLE PAY</span>
            <span class="payment-badge">GOOGLE PAY</span>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Brand Tagline",
      "default": "Architectural silhouettes, heavyweight organic textiles, and refined contemporary luxury engineered for modern life."
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show Payment Badges",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "link_column",
      "name": "Navigation Column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Column Heading",
          "default": "QUICK LINKS"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Select Menu"
        }
      ]
    }
  ]
}
{% endschema %}
