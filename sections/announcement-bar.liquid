{%- if section.settings.show_announcement -%}
  <aside class="announcement-bar" role="region" aria-label="Announcement">
    <div class="announcement-bar-content">
      <span>{{ section.settings.text }}</span>
    </div>
    {%- if section.settings.show_close -%}
      <button type="button" class="announcement-bar-close" aria-label="Close">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    {%- endif -%}
  </aside>
{%- endif -%}

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "Announcement Text",
      "default": "FREE SHIPPING ON ORDERS OVER LKR 10,000 • WORLDWIDE EXPRESS DISPATCH"
    },
    {
      "type": "checkbox",
      "id": "show_close",
      "label": "Allow customer to dismiss",
      "default": true
    }
  ]
}
{% endschema %}
